# ---------------------------------------------------------------------------
# Competitor Price Monitor — environment configuration
#
# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. NEVER commit real credentials.
# On Render, set these in the service's Environment tab (or as a secret group).
# ---------------------------------------------------------------------------

# REQUIRED — PostgreSQL connection string for your external Postgres provider.
# The app reads the database only from here; credentials are never hardcoded.
# Most hosted providers require SSL, which is the default. Append
# ?sslmode=disable only for a local Postgres without TLS.
DATABASE_URL=postgresql://user:password@host:5432/database

# Port the API listens on. Render injects this automatically — leave unset there.
PORT=3001

# development | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Authentication (optional for the MVP — Spec §7)
# ---------------------------------------------------------------------------

# Shared password for the whole app. Leave BLANK to run with no login gate.
# Set it for any deployment reachable from the internet.
APP_PASSWORD=

# Signs session cookies. REQUIRED in production whenever APP_PASSWORD is set.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Scraper politeness & robustness (Spec §5.4, §9)
# ---------------------------------------------------------------------------

# Identify yourself honestly. Put a real contact address here before go-live.
SCRAPER_USER_AGENT=WOSG-PriceMonitor/0.1 (+price monitoring; contact: trading@example.com)

# Global floor on the delay between requests to the SAME domain, in ms.
# A competitor's own Crawl-delay always wins if it is longer than this.
SCRAPER_MIN_DELAY_MS=3000

# Per-request timeout (ms) and the ceiling on concurrent requests per domain.
SCRAPER_TIMEOUT_MS=30000
SCRAPER_MAX_CONCURRENCY=2

# Leave as true. Set to false ONLY to test against your own local fixtures.
RESPECT_ROBOTS_TXT=true

# Optional: path to an existing Chromium binary. Leave unset to use the one
# `npx playwright install chromium` downloads.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Optional: paid unblocking backend, for competitors that refuse us directly.
#
# Leave these unset and the app behaves exactly as it always has — every
# request goes out from this host and nothing costs money. Set a provider and
# key and a *blocked* request may be retried through that service.
#
# It is never reached from a slow page or a bad selector, and not even from
# every block: a rate limit is fixed by slowing down, and a legal block or a
# login wall cannot be fixed at all, so neither is retried. Only confirmed
# matches can spend — discovery opens guesses and is given no allowance.
#
# UNBLOCKER_PROVIDER=zyte | brightdata | scrapingbee | scraperapi
# UNBLOCKER_API_KEY=
# UNBLOCKER_ZONE=            # Bright Data only; defaults to web_unlocker
#
# Hard ceiling on paid calls per run. A per-request charge with no cap is how
# a full-catalogue scan becomes an invoice nobody approved. Past the ceiling
# the run continues unblocked rather than failing.
UNBLOCKER_MAX_CALLS_PER_RUN=250

# ---------------------------------------------------------------------------
# Optional: collect the daily Google feeds from where they are already
# delivered, instead of waiting for someone to upload them.
#
# Worth more than the saved upload. A feed that travels via someone's desktop
# usually arrives having been opened in Excel, which turns a 13-digit GTIN into
# "7.32E+11" — in the first Goldsmiths feed that destroyed 263 of 266 of them.
# The EAN is the strongest way to match our products to a competitor's, and the
# only key that survives them using different SKUs to us.
#
# Unset means nothing changes: feeds are uploaded by hand as before.
#
# FEED_FTP_PROTOCOL=sftp      # sftp (default) | ftps | ftp
# FEED_FTP_HOST=
# FEED_FTP_PORT=              # defaults to 22 for sftp, 21 otherwise
# FEED_FTP_USER=
# FEED_FTP_PASSWORD=
# FEED_FTP_DIRECTORY=/feeds
#
# One pattern per site, keyed by fascia code. Only * is a wildcard.
# FEED_FTP_PATTERN_197=goldsmiths_*.csv
# FEED_FTP_PATTERN_439=mappin_*.csv
# FEED_FTP_PATTERN_470=watches_of_switzerland_*.csv

# ---------------------------------------------------------------------------
# The nightly job: collect the day's feeds, then scan competitors.
#
# Off by default, deliberately — a full scan starting by surprise on a
# deployment nobody is watching is how a compute quota disappears overnight.
#
# The two are one job rather than two schedules because the order matters: the
# feed defines what we currently sell, so scanning first means checking prices
# for products that may no longer be on the site and missing the ones that
# just appeared.
SCHEDULE_ENABLED=false
# 24-hour local time. Avoid 01:00–02:00: UK clock changes land there.
SCHEDULE_AT=03:00
SCHEDULE_TIMEZONE=Europe/London
# How long after the scheduled time a missed run is still worth starting.
SCHEDULE_CATCH_UP_HOURS=4
