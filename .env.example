# ---------------------------------------------------------------------------
# Competitor Price Monitor — environment configuration
#
# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. NEVER commit real credentials.
# On Render, set these in the service's Environment tab (or as a secret group).
# ---------------------------------------------------------------------------

# REQUIRED — PostgreSQL connection string for your external Postgres provider.
# The app reads the database only from here; credentials are never hardcoded.
# Most hosted providers require SSL, which is the default. Append
# ?sslmode=disable only for a local Postgres without TLS.
DATABASE_URL=postgresql://user:password@host:5432/database

# Port the API listens on. Render injects this automatically — leave unset there.
PORT=3001

# development | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Authentication (optional for the MVP — Spec §7)
# ---------------------------------------------------------------------------

# Shared password for the whole app. Leave BLANK to run with no login gate.
# Set it for any deployment reachable from the internet.
APP_PASSWORD=

# Signs session cookies. REQUIRED in production whenever APP_PASSWORD is set.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Scraper politeness & robustness (Spec §5.4, §9)
# ---------------------------------------------------------------------------

# Identify yourself honestly. Put a real contact address here before go-live.
SCRAPER_USER_AGENT=WOSG-PriceMonitor/0.1 (+price monitoring; contact: trading@example.com)

# Global floor on the delay between requests to the SAME domain, in ms.
# A competitor's own Crawl-delay always wins if it is longer than this.
SCRAPER_MIN_DELAY_MS=3000

# Per-request timeout (ms) and the ceiling on concurrent requests per domain.
SCRAPER_TIMEOUT_MS=30000
SCRAPER_MAX_CONCURRENCY=2

# Leave as true. Set to false ONLY to test against your own local fixtures.
RESPECT_ROBOTS_TXT=true

# Optional: path to an existing Chromium binary. Leave unset to use the one
# `npx playwright install chromium` downloads.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# debug | info | warn | error
LOG_LEVEL=info
